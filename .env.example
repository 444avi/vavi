# Vavi configuration — copy to .env (which is gitignored) and fill in.
# Vavi loads this file itself; no python-dotenv needed.

# --- Anthropic (required unless you run with --no-classify) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Finnhub (Sentinel market-cap gate) ---
# Free key from https://finnhub.io/register. Sentinel only notifies about
# companies at/above sentinel_config.MARKET_CAP_MIN_USD ($1B). Without this
# key the gate is fail-open (every company passes); set it to enforce the
# floor. Set MARKET_CAP_ENABLED=False in sentinel_config.py to disable entirely.
FINNHUB_API_KEY=

# --- Email / SMTP (required unless you run with --no-email) ---
# Defaults target Gmail. For Gmail you MUST use a 16-char App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal login password.
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER defaults to EMAIL_FROM if omitted.
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
