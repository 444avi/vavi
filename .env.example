# Vavi configuration — copy to .env (which is gitignored) and fill in.
# Vavi loads this file itself; no python-dotenv needed.

# --- Anthropic (required unless you run with --no-classify) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Finnhub (Sentinel market-cap gate) ---
# Free key from https://finnhub.io/register. Sentinel only notifies about
# companies at/above sentinel_config.MARKET_CAP_MIN_USD ($1B). Without this
# key the gate is fail-open (every company passes); set it to enforce the
# floor. Set MARKET_CAP_ENABLED=False in sentinel_config.py to disable entirely.
FINNHUB_API_KEY=

# --- Email / SMTP (required unless you run with --no-email) ---
# Defaults target Gmail. For Gmail you MUST use a 16-char App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal login password.
EMAIL_FROM=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER defaults to EMAIL_FROM if omitted.
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# --- Recipient lists ---------------------------------------------------------
# Three logical audiences across the two programs. Each var may be a
# comma-separated list of addresses.
#
#   EMAIL_TO       -> the shared "everyone" list. SENTINEL emails this list, and
#                     plain Vavi FALLS BACK to it when EMAIL_TO_VAVI is unset.
#   EMAIL_TO_VAVI  -> plain-Vavi subset (no Kalshi section). Optional; if unset,
#                     plain Vavi goes to EMAIL_TO.
#   EMAIL_TO_KS    -> Vavi.ks subset (gets the "Relevant Kalshi markets" copy).
#                     Optional; if unset, no second copy is sent at all.
#
# The plain Vavi email and the Vavi.ks email are two independent messages, so
# keep EMAIL_TO_VAVI and EMAIL_TO_KS disjoint — nobody should be on both.
#
# For "everyone gets Sentinel; each person gets vavi OR vavi.ks":
#   EMAIL_TO      = everyone            (Sentinel; = union of the two below)
#   EMAIL_TO_VAVI = the plain-only folk
#   EMAIL_TO_KS   = the Kalshi folk
#
# For the original single-list behavior, just set EMAIL_TO and leave the other
# two empty: Sentinel and plain Vavi both go to EMAIL_TO, no Kalshi copy.
EMAIL_TO=you@gmail.com
EMAIL_TO_VAVI=
EMAIL_TO_KS=
